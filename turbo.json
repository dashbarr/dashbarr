{
    "$schema": "https://turborepo.org/schema.json",
    "globalDependencies": ["**/.env"],
    "concurrency": "100",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**", ".next/**"]
        },
        "dev": {
            "persistent": true,
            "cache": false
        },
        "format": {
            "outputs": ["node_modules/.cache/.prettiercache"],
            "outputLogs": "new-only"
        },
        "typecheck": {
            "outputs": ["node_modules/.cache/tsbuildinfo.json"],
            "outputLogs": "new-only"
        },
        "clean": {
            "cache": false
        }
    }
}
