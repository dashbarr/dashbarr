{
    "name": "dashbarr",
    "version": "0.1.0",
    "type": "module",
    "packageManager": "bun@1.3.5",
    "engines": {
        "node": ">=25.2.1",
        "bun": ">=1.3.5"
    },
    "author": {
        "name": "Sebastian Inman",
        "email": "hello@sebastiancodes.com"
    },
    "prettier": "@dashbarr/prettier",
    "workspaces": [
        "apps/*",
        "packages/*",
        "plugins/**/*"
    ],
    "scripts": {
        "generate": "bun run scripts/generate-plugin.ts",
        "generate:integration": "bun generate --integration",
        "generate:theme": "bun generate --theme",
        "generate:widget": "bun generate --widget",
        "clean": "turbo clean && rm -rf .turbo node_modules bun.lock",
        "build": "cross-env NODE_ENV=production turbo build",
        "dev": "cross-env NODE_ENV=development turbo dev",
        "format": "turbo format --continue -- --cache --cache-location node_modules/.cache/.prettiercache",
        "format:fix": "turbo format --continue -- --write --cache --cache-location node_modules/.cache/.prettiercache",
        "typecheck": "turbo typecheck",
        "test": "vitest"
    },
    "devDependencies": {
        "@inquirer/prompts": "^8.3.0",
        "@dashbarr/common": "workspace:*",
        "@dashbarr/prettier": "workspace:*",
        "@dashbarr/typescript": "workspace:*",
        "@types/node": "^25.3.0",
        "cross-env": "^10.1.0",
        "handlebars": "^4.7.8",
        "prettier": "^3.8.1",
        "ts-command-line-args": "^2.5.1",
        "turbo": "^2.8.10",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    }
}
